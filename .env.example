# Sanity
# Both are published values, safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=kwna7ve9
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed to read drafts or write. Published reads on a public dataset need
# no token. Server-only — never prefix this with NEXT_PUBLIC_.
SANITY_API_TOKEN=

# Sanity webhook → ISR revalidation
REVALIDATE_SECRET=

# Resend (transactional email)
# With RESEND_API_KEY unset, /api/contact logs inquiries server-side and returns
# success so the form is demoable. Setting it switches to a real send.
RESEND_API_KEY=
# Optional sender override. Needs a domain verified in Resend; defaults to
# Resend's shared onboarding sender, which only delivers to the account owner.
RESEND_FROM_EMAIL=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
