# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# browser-automation artifacts (Playwright MCP snapshots, console logs, screenshots)
/.playwright-mcp/
/*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored AI-agent skills — third-party docs pulled from sanity-io/agent-toolkit,
# reinstallable from skills-lock.json. Not project code.
# .claude/skills is a symlink into .agents/; .claude itself stays trackable so
# shared project settings can be committed later.
/.agents/
/.claude/skills/
