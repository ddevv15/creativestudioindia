# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# browser-automation artifacts (Playwright MCP snapshots, console logs, screenshots)
/.playwright-mcp/
/*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-agent tooling — installed per-developer, never part of the build.
#
# /.agents/  vendored Sanity skill docs from sanity-io/agent-toolkit,
#            reinstallable from skills-lock.json
# /.claude/  ECC project-local install (~488 files: rules, agents, commands,
#            skills). ECC owns this whole directory — it writes its own
#            AGENTS.md, plugin.json and marketplace.json at the root — so the
#            directory is ignored wholesale rather than per-subtree. Reinstall
#            with:
#              npx ecc-universal install --target claude-project --profile minimal
/.agents/
/.claude/
